[{"text":"–","box":[109.99972534179688,45.37873840332031,122.42469787597656,74.67866516113281]},{"text":" Portfolio","box":[131.1244659423828,42.594749450683594,248.97119140625,75.4106674194336]},{"text":"战略层","box":[1743.42626953125,50.938568115234375,1814.9940185546875,79.06649780273438]},{"text":"管理视角","box":[142.99964904785156,455.2813720703125,222.5194549560547,478.7213134765625]},{"text":"需要同时掌握项目进度与财务数据，","box":[126.99967956542969,508.4543151855469,556.40673828125,540.0982666015625]},{"text":"但系统分离、权限交织，","box":[126.99967956542969,553.0042114257812,422.2170104980469,584.6481323242188]},{"text":"全局判断与审计追溯缺少连续上下文。","box":[126.99967956542969,597.5540771484375,583.2446899414062,629.197998046875]},{"text":"执行视角","box":[740.9981689453125,455.2813720703125,820.5179443359375,478.7213134765625]},{"text":"功能入口多、任务分散。","box":[724.9981689453125,508.4543151855469,1020.215576171875,540.0982666015625]},{"text":"成员在不同系统之间切换，","box":[724.9981689453125,553.0042114257812,1047.053466796875,584.6481323242188]},{"text":"还需反复沟通、核对项目数据。","box":[724.9981689453125,597.5540771484375,1100.7293701171875,629.197998046875]},{"text":"01","box":[1319.9967041015625,422.41375732421875,1357.715576171875,461.08966064453125]},{"text":"项目进度与财务数据分开呈现。","box":[1409.9964599609375,478.70941162109375,1716.148193359375,504.49334716796875]},{"text":"02","box":[1319.9967041015625,579.4133911132812,1363.424560546875,618.0892944335938]},{"text":"可见范围与操作责任需要清楚划分。","box":[1409.9964599609375,635.708984375,1759.8841552734375,661.492919921875]},{"text":"03","box":[1319.9967041015625,736.4130249023438,1363.16064453125,775.0889282226562]},{"text":"功能入口不能替代真实工作流程。","box":[1409.9964599609375,792.7086181640625,1738.0162353515625,818.4925537109375]},{"text":"设计方向","box":[161.9995880126953,803.4447631835938,251.48638916015625,828.0567016601562]},{"text":"把人、项目、经费与成果连接起来，","box":[161.9995880126953,845.5341186523438,655.0223388671875,881.8660278320312]},{"text":"让跨角色协作沿着同一条项目链路展开。","box":[161.9995880126953,888.9339599609375,716.6502685546875,925.265869140625]},{"text":"来源：原始 Figma · 2167:10058 · 2167:10042　｜　业务背景与产品定位。","box":[109.99972534179688,1032.5963134765625,585.73193359375,1049.0042724609375]},{"text":"22","box":[1817.7630615234375,1027.771728515625,1844.994873046875,1054.7276611328125]},{"text":"项目背景与业务复杂性挑战","box":[126.99970245361328,138.67140197753906,806.895751953125,195.67140197753906]},{"text":"项目管理与财务流程分离，","box":[126.99970245361328,326.337890625,520.6237182617188,359.337890625]},{"text":"让同一个项目出现两套工作视图。","box":[126.99970245361328,372.537841796875,619.0297241210938,405.537841796875]},{"text":"当前问题","box":[1319.9969482421875,328.337890625,1451.2049560546875,361.337890625]},{"text":"信息割裂","box":[1409.9959716796875,424.33770751953125,1541.2039794921875,457.33770751953125]},{"text":"角色交织","box":[1409.9959716796875,581.3373413085938,1541.2039794921875,614.3373413085938]},{"text":"路径复杂","box":[1409.9959716796875,738.3369140625,1541.2039794921875,771.3369140625]},{"text":"问题不在单个功能，而在业务进度、经费执行和角色责任之间的断点。","box":[128.99969482421875,228.7442169189453,960.97802734375,255.7442169189453]}]