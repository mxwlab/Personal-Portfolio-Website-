[{"text":"01","box":[67.06519317626953,-30.795120239257812,179.48275756835938,152.51840209960938]},{"text":"04","box":[67.85398864746094,-27.639907836914062,213.17967224121094,155.67361450195312]},{"text":"领\n","box":[94.1377944946289,182.9704132080078,131.20993041992188,244.51016235351562]},{"text":"导\n","box":[94.1377944946289,231.9958953857422,131.20993041992188,293.53564453125]},{"text":"驾\n","box":[94.1377944946289,281.0213623046875,131.20993041992188,342.5611267089844]},{"text":"驶\n","box":[94.1377944946289,330.046875,131.20993041992188,391.58660888671875]},{"text":"舱","box":[94.1377944946289,379.07232666015625,131.20993041992188,440.6120910644531]},{"text":"领\n","box":[99.05892944335938,187.8231964111328,136.13107299804688,249.36294555664062]},{"text":"导\n","box":[99.05892944335938,233.8471221923828,136.13107299804688,295.3868713378906]},{"text":"驾\n","box":[99.05892944335938,279.87103271484375,136.13107299804688,341.4107971191406]},{"text":"驶\n","box":[99.05892944335938,325.89495849609375,136.13107299804688,387.4347229003906]},{"text":"舱","box":[99.05892944335938,371.91888427734375,136.13107299804688,433.4586181640625]},{"text":"领导驾驶舱","box":[232.93978881835938,62.08445358276367,378.076171875,114.45974731445312]},{"text":"导航页是整个可视化平","box":[1474.2110595703125,134.72958374023438,1654.3046875,164.6251220703125]},{"text":"台","box":[1654.3046875,141.4470672607422,1672.3140869140625,164.6251220703125]},{"text":"最重要的页面。","box":[1672.31396484375,134.72958374023438,1798.3795166015625,164.6251220703125]},{"text":"一、在商业层面，","box":[1474.2110595703125,180.06175231933594,1618.2860107421875,209.95729064941406]},{"text":"导航页是","box":[1618.285888671875,182.90322875976562,1682.3192138671875,209.47703552246094]},{"text":"公司","box":[1682.3192138671875,188.87432861328125,1714.3358154296875,209.47703552246094]},{"text":"对接客户的一个重点","box":[1714.3358154296875,182.90322875976562,1858.41064453125,209.47703552246094]},{"text":"页面，因此导航页的设计在整个平","box":[1474.2110595703125,206.91571044921875,1714.3358154296875,233.48951721191406]},{"text":"台","box":[1714.3358154296875,212.88681030273438,1730.3441162109375,233.48951721191406]},{"text":"中","box":[1730.34423828125,206.91571044921875,1746.3525390625,233.48951721191406]},{"text":"具有非常","box":[1746.3525390625,212.88681030273438,1810.3857421875,233.48951721191406]},{"text":"重要的","box":[1810.3857421875,206.91571044921875,1858.41064453125,233.48951721191406]},{"text":"商业价值","box":[1474.2110595703125,236.89927673339844,1538.2442626953125,257.5019836425781]},{"text":"。","box":[1538.244384765625,230.9281768798828,1554.252685546875,257.5019836425781]},{"text":"二、在用户层面，","box":[1474.2110595703125,278.96368408203125,1618.2860107421875,308.8592224121094]},{"text":"它是政府各层领导最关注的一个页","box":[1618.285888671875,281.80517578125,1858.41064453125,308.3789978027344]},{"text":"面，起到一个对外宣传、展示、向上汇报的重要作用，","box":[1474.2110595703125,305.8176574707031,1858.41064453125,332.3914794921875]},{"text":"因此导航页设计的好坏直接影响了产品在客户心中的形","box":[1474.2110595703125,329.83013916015625,1858.41064453125,356.4039611816406]},{"text":"象。","box":[1474.2110595703125,353.8426208496094,1506.2276611328125,380.41644287109375]},{"text":"三","box":[1474.2110595703125,407.5956115722656,1492.220458984375,430.7736511230469]},{"text":"、在","box":[1492.220458984375,400.87811279296875,1528.2391357421875,430.7736511230469]},{"text":"交互视觉","box":[1528.2391357421875,407.5956115722656,1600.276611328125,430.7736511230469]},{"text":"层面，","box":[1600.276611328125,400.87811279296875,1654.3046875,430.7736511230469]},{"text":"它的色调选择、风格设","box":[1654.3046875,409.6907043457031,1814.3878173828125,430.2934265136719]},{"text":"计、交互方式决定了整个平台所有页面的设计走向。","box":[1474.2110595703125,433.70318603515625,1842.40234375,454.305908203125]},{"text":"我们在尝试了多版方案后选择了这版导航，原因","box":[1473.72607421875,487.9130859375,1851.9227294921875,517.8086547851562]},{"text":"如下：\n\n","box":[1473.72607421875,514.9271240234375,1527.754150390625,544.8226928710938]},{"text":"｜聚焦\n","box":[1473.72607421875,565.9536743164062,1527.754150390625,595.8492431640625]},{"text":"板式布局上使用了中心式布局，聚焦了南阳市区域地","box":[1473.72607421875,592.8076171875,1841.91748046875,619.3814086914062]},{"text":"图，将用户的注意力集中到可视化界面中最重要的区","box":[1473.72607421875,616.820068359375,1841.91748046875,643.3938598632812]},{"text":"域，从而将南阳市重要的数据信息凸显出来，抓住用","box":[1473.72607421875,640.8325805664062,1841.91748046875,667.4063720703125]},{"text":"户的注意力，提升用户信息解读的效率。\n\n","box":[1473.72607421875,664.8450927734375,1761.8758544921875,691.4188842773438]},{"text":"｜平衡\n","box":[1473.72607421875,713.0300903320312,1527.754150390625,742.9256591796875]},{"text":"左右两侧以及底部设计了选择标签，合理的利用可视","box":[1473.72607421875,739.884033203125,1841.91748046875,766.4578247070312]},{"text":"化的设计空间，在确保重要信息位于可视化空间视觉","box":[1473.72607421875,763.8965454101562,1841.91748046875,790.4703369140625]},{"text":"中心的情况下，保证整个页面的不同元素在空间位置","box":[1473.72607421875,787.9090576171875,1841.91748046875,814.4828491210938]},{"text":"上处于平衡，提升设计美感。\n\n","box":[1473.72607421875,811.9215087890625,1681.834228515625,838.4953002929688]},{"text":"｜简洁\n","box":[1473.72607421875,860.1065063476562,1527.754150390625,890.0020751953125]},{"text":"在可视化整体布局中，重点突出，避免了过于复杂或","box":[1473.72607421875,886.9605102539062,1841.91748046875,913.5343017578125]},{"text":"影响数据呈现效果的冗余元素。\n","box":[1473.72607421875,910.9729614257812,1697.842529296875,937.5467529296875]}]