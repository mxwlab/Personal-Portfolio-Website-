{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public AI usage aggregates only",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "status",
          "timeZone",
          "coverageStart",
          "coverageEnd",
          "updatedAt",
          "daily",
          "verified",
          "semantics"
        ],
        "properties": {
          "source": {
            "enum": [
              "codex",
              "claude-code",
              "deepseek-harness"
            ]
          },
          "status": {
            "enum": [
              "pending",
              "unavailable",
              "needs-review",
              "connected"
            ]
          },
          "timeZone": {
            "type": [
              "string",
              "null"
            ],
            "description": "IANA timezone of daily aggregation; null before import"
          },
          "coverageStart": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "coverageEnd": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "daily": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "date",
                "calls",
                "inputTokensUncached",
                "outputTokens",
                "cacheReadTokens",
                "cacheWriteTokens"
              ],
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "calls": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "inputTokensUncached": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "outputTokens": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "cacheReadTokens": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "cacheWriteTokens": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                }
              }
            }
          },
          "verified": {
            "type": "boolean"
          },
          "semantics": {
            "enum": [
              null,
              "disjoint-tokens-v1"
            ]
          }
        }
      },
      "minItems": 3,
      "maxItems": 3
    }
  }
}